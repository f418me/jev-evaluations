TYPESAFE_API_KEY=
JEV_MODEL=typesafe:jev-latest
# Keys for providers configured in models.json:
OPENAI_API_KEY=
GROQ_API_KEY=
# Optional Google provider:
GOOGLE_API_KEY=

# Amazon Bedrock: choose region and ONE authentication method.
# AWS_DEFAULT_REGION=eu-north-1
# AWS_PROFILE=my-profile
# Or AWS credentials (session token only for temporary credentials):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Or a Bedrock API key:
# AWS_BEARER_TOKEN_BEDROCK=
# Optional boto3 transport timeouts in seconds:
# AWS_READ_TIMEOUT=30
# AWS_CONNECT_TIMEOUT=10

